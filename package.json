{
  "name": "wa-agent",
  "version": "1.0.0",
  "description": "Deterministic WhatsApp Control Plane for Claude Code and CLI Agents",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/database/schema.sql dist/database/schema.sql",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "sim": "tsx src/cli/simulator.ts",
    "test": "NODE_ENV=test tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "claude",
    "whatsapp",
    "control-plane",
    "cli-automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.19",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
