[Unit]
Description=WA-Agent WhatsApp Control Plane Daemon
After=network.target

[Service]
Type=simple
User=wa-agent
Group=wa-agent
WorkingDirectory=/opt/wa-agent
EnvironmentFile=/etc/wa-agent/environment
Environment=HOME=/var/lib/wa-agent
Environment=PATH=/opt/wa-agent/bin:/var/lib/wa-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/wa-agent/bin/node /opt/wa-agent/dist/index.js
Restart=always
RestartSec=5

# Security Hardening & Sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

# Writable state directory for SQLite, Baileys credentials, logs, and agent home state
ReadWritePaths=/var/lib/wa-agent

# Resource limits
LimitNOFILE=65535
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
