[Unit]
Description=Claude Code WhatsApp Control Plane Daemon
After=network.target

[Service]
Type=simple
User=hanzlaahmad
Group=hanzlaahmad
WorkingDirectory=/home/hanzlaahmad/PersonalProjects/WA-Agent
EnvironmentFile=/home/hanzlaahmad/PersonalProjects/WA-Agent/.env
Environment=PATH=/home/hanzlaahmad/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /home/hanzlaahmad/PersonalProjects/WA-Agent/dist/index.js
Restart=always
RestartSec=5

# Security Hardening & Sandboxing
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

# Explicit ReadWritePaths required for Claude Code CLI, Antigravity CLI (agy), Codex CLI, and WA-Agent persistence
ReadWritePaths=/home/hanzlaahmad/PersonalProjects /home/hanzlaahmad/PersonalProjects/WA-Agent/data /home/hanzlaahmad/PersonalProjects/WA-Agent/auth_info_baileys /home/hanzlaahmad/.claude /home/hanzlaahmad/.claude.json /home/hanzlaahmad/.gemini/antigravity-cli /home/hanzlaahmad/.codex

# Resource limits
LimitNOFILE=65535
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
