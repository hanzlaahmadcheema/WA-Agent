# WhatsApp Control Plane Environment Configuration

# Comma-separated absolute paths where the agent is allowed to operate
ALLOWED_ROOTS=/home/hanzlaahmad/PersonalProjects

# Admin WhatsApp phone number (digits only, e.g. 1234567890)
ADMIN_PHONE_NUMBER=1234567890
# Additional authorized WhatsApp phone numbers (comma-separated digits)
# AUTHORIZED_PHONE_NUMBERS=

# Database & Logging
DATABASE_PATH=./data/control_plane.db
LOG_DIR=./data/logs

# Default CLI agent & model
DEFAULT_AGENT=claude
DEFAULT_MODEL=claude-3-7-sonnet

# Log level (debug, info, warn, error)
LOG_LEVEL=info
